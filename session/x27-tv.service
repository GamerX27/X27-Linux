# X27 TV kiosk session: logs @USER@ straight into X27 TV on tty1 at boot, no display
# manager. Restarts on crashes; a clean exit (Exit in the Control Center) returns to the console.
[Unit]
Description=X27 TV session
After=systemd-user-sessions.service plymouth-quit-wait.service dbus.socket systemd-logind.service getty@tty1.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=@USER@
PAMName=x27-tv
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SEAT=seat0 XDG_VTNR=1
ExecStart=/usr/local/bin/x27-tv-session
ExecStopPost=+/bin/sh -c '[ "$SERVICE_RESULT" = success ] && systemctl --no-block start getty@tty1.service || true'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target

#!/usr/bin/env bash
# /usr/bin/dnf5 points here on X27-Linux. Image builds (no /run/ostree-booted) get the real dnf5.
if [[ ! -e /run/ostree-booted ]]; then
  exec /usr/libexec/dnf5-real "$@"
fi

cat >&2 <<'MSG'
dnf is disabled on X27-Linux. The system image is read-only and replaced on
every update, so packages installed with dnf would not stick.

  Apps:            Bazaar
  CLI/dev tools:   distrobox create && distrobox enter
  System packages: sudo rpm-ostree install <package>
  Updates:         topgrade
MSG
exit 1
